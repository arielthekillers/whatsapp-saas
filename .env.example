APP_ENV=production
APP_URL=https://yourdomain.com

DB_HOST=your_db_host
DB_PORT=3306
DB_DATABASE=whatsapp_saas
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

WAHA_BASE_URL=http://your-waha-server:3000
WAHA_API_KEY=your_waha_api_key_here
WAHA_TIMEOUT=15

# Generate with: php -r "echo bin2hex(random_bytes(32));"
CRYPTO_KEY=generate_a_strong_random_key_here

# Manual Payment Config (QRIS)
PAYMENT_METHOD=qris
QRIS_MERCHANT_NAME=Sintesa Digital
QRIS_NMID=ID1026617983899
QRIS_IMAGE_PATH=/images/qris.jpeg
BANK_WHATSAPP=+6281234567890

